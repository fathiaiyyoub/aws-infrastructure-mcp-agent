AWS_PROFILE=replace-with-your-own-profile
AWS_REGION=ap-southeast-2
DEPLOYMENT_ENV=development
MONTHLY_BUDGET_USD=20
PRODUCTION_ALLOWED=false
# Deployment settings are policy context, not independently enforced controls.
